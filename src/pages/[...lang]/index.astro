---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Btn from '../../components/Btn.astro';
import Logo from '../../components/Logo.astro';
import Clip from '../../components/Clip.astro';
import Stories from '../../components/Stories.astro';
import Wordmark from '../../components/Wordmark.astro';
import { Image } from 'astro:assets';
import { photos } from '../../data/media';
import { mt } from '../../i18n/media';
import TourCard from '../../components/TourCard.astro';
import { ui } from '../../i18n/ui';
import { langMeta, path, staticLangPaths, type Lang } from '../../i18n/langs';
import { tours, operator } from '../../data/tours';

export const getStaticPaths = staticLangPaths;
const { lang } = Astro.props as { lang: Lang };
const t = ui[lang];
const m = mt[lang];
const eagle = tours.find((x) => x.slug === 'eagle-hunters')!;
const travellers = tours.reduce((s, x) => s + x.reviews, 0);
const places = { en: ['Charyn', 'Kolsai', 'Kaindy', 'Big Almaty Lake', 'Shymbulak', 'Medeu', 'Altyn-Emel', 'Kok-Tobe'], ru: ['Чарын', 'Кольсай', 'Каинды', 'БАО', 'Шымбулак', 'Медеу', 'Алтын-Эмель', 'Кок-Тобе'], kk: ['Шарын', 'Көлсай', 'Қайыңды', 'Үлкен Алматы көлі', 'Шымбұлақ', 'Медеу', 'Алтынемел', 'Көктөбе'], ar: ['شارين', 'كولساي', 'كايندي', 'بحيرة ألماتي', 'شيمبولاك', 'ميديو', 'ألتين إيميل', 'كوك توبي'], zh: ['恰林', '科尔赛', '凯因迪', '大阿拉木图湖', '琼布拉克', '麦迪奥', '阿尔泰-埃梅尔', '阔克托别'], hi: ['चारिन', 'कोलसाई', 'काइंडी', 'बिग अल्माटी लेक', 'शिम्बुलाक', 'मेडेउ', 'अल्टिन-एमेल', 'कोक-टोबे'] }[lang];
const schema = {
  '@context': 'https://schema.org', '@type': 'TravelAgency', name: `${operator.name} (concept)`, url: new URL(path(lang), Astro.site).href,
  address: { '@type': 'PostalAddress', addressLocality: 'Almaty', addressCountry: 'KZ' }, inLanguage: langMeta[lang].locale,
};
const wa = `https://wa.me/${operator.whatsapp}`;
// Next six months for the trip finder
const months = [...Array(6)].map((_, i) => { const d = new Date(2026, 9 + i, 1); return { v: `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`, l: d.toLocaleDateString(langMeta[lang].locale, { month: 'long', year: 'numeric' }) }; });
// Editorial mosaic of places: second photo of four tours, placed off-grid with parallax
const whyIcons = [
  '<path d="M3 12V4h8l10 10-8 8z"/><circle cx="7.5" cy="8.5" r="1.4"/>',
  '<rect x="3" y="6" width="18" height="13" rx="2.5"/><path d="M3 10h18M7 15h3"/>',
  '<path d="M4 12a8 8 0 1 0 2.4-5.7M4 4v4.5h4.5"/>',
  '<path d="M4 5h16v10H9l-5 4z"/><path d="M8 9h8M8 12h5"/>',
];
const places4 = (['charyn-kolsai-kaindy', 'big-almaty-lake', 'kolsai-two-days', 'altyn-emel-dune'] as const).map((slug, i) => ({ tour: tours.find((x) => x.slug === slug)!, pic: photos(slug)[slug === 'charyn-kolsai-kaindy' ? 4 : slug === 'big-almaty-lake' ? 0 : 1] }));
---
<Base lang={lang} title={t.meta.title} description={t.meta.description} schema={schema}>
  <!-- Intro: the sun ring and the eagle's wings draw themselves, then the name appears -->
  <div class="kpre" data-preloader aria-hidden="true">
    <div class="flex flex-col items-center gap-6 text-snow">
      <Logo class="size-32" draw />
      <span class="overflow-hidden px-2 py-1"><span class="block" data-pre-text><Wordmark class="!text-[26px]" /></span></span>
      <span class="text-[11px] font-semibold tracking-[.3em] text-gold-2/80 uppercase" data-pre-text>{t.pre}</span>
    </div>
  </div>
  <div class="kprogress" data-progress-bar aria-hidden="true"></div>
  <div class="kcursor" data-cursor-el aria-hidden="true"><span class="kcursor-dot"></span><span class="kcursor-label" data-cursor-label></span></div>

  <Header lang={lang} />

  <!-- HERO: a 10 s reel of real places (vertical on phones), the trip finder on top of it -->
  <section class="relative isolate overflow-hidden bg-night" data-hero>
    <div class="absolute inset-0 -z-10" data-hero-img><Clip name="hero" alt={places.slice(0, 4).join(', ')} eager /></div>
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-night/90 via-night/25 to-night/35"></div>
    <div class="mx-auto flex min-h-[100svh] max-w-[1440px] flex-col justify-end px-4 pb-6 pt-28 text-white md:px-10 md:pb-12">
      <p class="kick !text-gold-2" data-reveal>{t.hero.kicker}</p>
      <h1 class="display t-mega mt-4 max-w-[11ch] [&_span]:text-gold-2" data-split set:html={t.hero.title} />
      <p class="mt-4 max-w-[42ch] text-[16px] text-white/85 md:text-[17px]" data-reveal>{t.hero.text}</p>
      <form class="finder mt-7 grid gap-2 rounded-[22px] bg-white p-2 text-night shadow-[0_30px_60px_-30px_rgba(0,0,0,.6)] md:mt-9 md:grid-cols-[1.4fr_1fr_0.7fr_auto] md:gap-0 md:p-2" data-finder data-reveal>
        <label class="finder-f"><span>{m.where}</span><select name="tour"><option value="">{m.anyTour}</option>{tours.map((x) => <option value={x.slug}>{x.name[lang]}</option>)}</select></label>
        <label class="finder-f hidden md:flex"><span>{m.when}</span><select name="month">{months.map((x) => <option value={x.v} class="capitalize">{x.l}</option>)}</select></label>
        <label class="finder-f hidden md:flex"><span>{m.guests}</span><select name="guests">{[1, 2, 3, 4, 5, 6, 7, 8].map((n) => <option value={n} selected={n === 2}>{n}</option>)}</select></label>
        <button class="kbtn kbtn-gold press w-full md:w-auto" type="submit">{m.find}<span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></span></button>
      </form>
      <p class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-1 text-[13px] text-white/80" data-reveal>
        <span class="flex items-center gap-1.5"><span class="text-gold" aria-hidden="true">★★★★★</span><b class="num text-white">4.9</b> {t.hero.rating}</span>
        <span><b class="num text-white" dir="ltr">{travellers.toLocaleString('en-US')}+</b> {t.hero.travellers}</span>
        <span><b class="num text-white">5</b> {t.hero.langs}</span>
      </p>
    </div>
  </section>

  <!-- STORIES: every tour as a 15-second vertical story -->
  <section class="bg-snow pb-10 pt-10 md:pb-16 md:pt-16">
    <div class="mx-auto max-w-[1440px] px-4 md:px-10">
      <div class="mb-6 flex items-end justify-between gap-4 md:mb-8">
        <h2 class="display t-l">{m.stories}</h2>
        <p class="hidden shrink-0 items-center gap-2 text-[14px] font-semibold text-stone sm:flex"><svg viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" /></svg>{m.watch}</p>
      </div>
      <Stories lang={lang} />
    </div>
  </section>

  <div class="kmarquee bg-night py-5 text-snow/90" data-marquee="30" aria-hidden="true">
    <div data-marquee-track>{[0, 1].map(() => places.map((p) => <span class="display flex items-center gap-6 pe-6 text-[clamp(30px,4vw,54px)]">{p}<Logo class="size-9 text-snow/70" /></span>))}</div>
  </div>

  <!-- TOURS -->
  <section id="tours" class="scroll-mt-16 py-16 md:py-24 lg:py-28">
    <div class="mx-auto max-w-[1440px] px-4 md:px-10">
      <p class="kick" data-reveal>{t.nav.tours}</p>
      <h2 class="display t-xl mt-3" data-split>{lang === 'en' ? 'Pick your day' : t.nav.tours}</h2>
      <div class="-mx-4 mt-6 flex gap-2 overflow-x-auto px-4 pb-1 md:mx-0 md:px-0" style="scrollbar-width:none" role="toolbar">
        {([['all', t.filters.all], ['day', t.filters.day], ['multi', t.filters.multi], ['easy', t.filters.easy]] as const).map(([k, l], i) => <button type="button" class="chip press" aria-pressed={i === 0 ? 'true' : 'false'} data-filter={k}>{l}</button>)}
      </div>
      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 lg:gap-6">
        {tours.map((x) => <TourCard tour={x} lang={lang} />)}
      </div>
    </div>
  </section>

  <!-- PLACES: editorial, off-grid photos with parallax -->
  <section class="overflow-hidden pb-16 md:pb-28">
    <div class="mx-auto max-w-[1440px] px-4 md:px-10">
      <p class="kick" data-reveal>{m.places}</p>
      <h2 class="display t-xl mt-3 max-w-[14ch]" data-split>{m.placesTitle}</h2>
      <div class="mt-10 grid grid-cols-2 items-end gap-x-3 gap-y-6 md:mt-14 md:grid-cols-12 md:gap-x-6 md:gap-y-12">
        {places4.map(({ tour, pic }, i) => (
          <a href={path(lang, `/tours/${tour.slug}/`)} class:list={['group block', ['col-span-2 md:col-span-7', 'md:col-span-5', 'md:col-span-5', 'col-span-2 md:col-span-7'][i]]} data-cursor={t.card.details}>
            <div class:list={['relative overflow-hidden rounded-[22px]', i === 0 || i === 3 ? 'aspect-[4/3] md:aspect-[16/11]' : 'aspect-[3/4] md:aspect-[5/6]']} data-zoom>
              <Image src={pic} alt={tour.name[lang]} widths={[480, 800, 1200, 1600]} sizes={i === 0 ? '(min-width: 768px) 58vw, 100vw' : '(min-width: 768px) 35vw, 50vw'} format="webp" loading="lazy" class="absolute inset-0 h-full w-full object-cover" />
            </div>
            <p class="mt-3 flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1"><span class:list={['display min-w-0', i === 1 || i === 2 ? 'text-[20px] leading-[1.05] md:text-[28px]' : 't-m']}>{tour.name[lang]}</span><span class="label shrink-0 text-[18px] text-sky num">{tour.days > 1 ? `${tour.days} ${t.card.d}` : `${tour.hours} ${t.card.h}`}</span></p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- WHY DIRECT -->
  <section id="why" class="relative isolate scroll-mt-16 overflow-hidden bg-night py-16 text-white md:py-28">
    <Clip name="steppe" alt="" class="-z-10 opacity-60" />
    <div class="absolute inset-0 -z-10 bg-gradient-to-b from-night/85 via-night/55 to-night/90"></div>
    <div class="mx-auto max-w-[1440px] px-4 md:px-10">
      <p class="kick !text-gold-2" data-reveal>{t.why.kicker}</p>
      <h2 class="display t-xl mt-3 max-w-[14ch]" data-split>{t.why.title}</h2>
      <div class="mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {t.why.items.map(([h, p], i) => (
          <article class="rounded-[22px] bg-white/[.07] p-6 ring-1 ring-white/15 backdrop-blur-md" data-reveal>
            <span class="grid size-12 place-items-center rounded-full text-gold-2 ring-1 ring-gold/50"><svg viewBox="0 0 24 24" class="size-[22px]" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={whyIcons[i]} /></span>
            <h3 class="display t-m mt-8">{h}</h3>
            <p class="mt-2 text-[15px] text-white/70">{p}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- EAGLE FEATURE -->
  <section class="relative isolate overflow-hidden">
    <div class="absolute inset-0 -z-10" data-zoom><Image src={photos('eagle-hunters')[3]} alt={eagle.name[lang]} widths={[640, 1000, 1600, 2000]} sizes="100vw" format="webp" loading="lazy" class="absolute inset-0 h-full w-full object-cover object-[50%_40%]" /></div>
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-night/90 via-night/35 to-transparent"></div>
    <div class="mx-auto flex min-h-[88svh] max-w-[1440px] flex-col justify-end px-4 pb-16 text-white md:px-10">
      <p class="kick !text-gold-2" data-reveal>{t.eagle.kicker}</p>
      <h2 class="display t-xl mt-3 max-w-[12ch]" data-split>{t.eagle.title}</h2>
      <p class="mt-4 max-w-[46ch] text-white/85" data-reveal>{t.eagle.text}</p>
      <div class="mt-7" data-reveal><Btn href={path(lang, `/tours/${eagle.slug}/`)} variant="gold">{t.eagle.cta}</Btn></div>
    </div>
  </section>

  <!-- AGENCIES -->
  <section id="agencies" class="scroll-mt-16 py-16 md:py-24">
    <div class="mx-auto grid max-w-[1440px] items-center gap-8 px-4 md:grid-cols-[1.2fr_0.8fr] md:px-10">
      <div>
        <p class="kick" data-reveal>{t.agencies.kicker}</p>
        <h2 class="display t-xl mt-3" data-split>{t.agencies.title}</h2>
        <p class="mt-4 max-w-[48ch] text-stone" data-reveal>{t.agencies.text}</p>
      </div>
      <div class="flex md:justify-end" data-reveal><Btn href={`${wa}?text=${encodeURIComponent('Agency rates request')}`} target="_blank" variant="night">{t.agencies.cta}</Btn></div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="scroll-mt-16 bg-mist py-16 md:py-24">
    <div class="mx-auto max-w-[900px] px-4 md:px-10">
      <h2 class="display t-l" data-split>{t.faq.title}</h2>
      <div class="mt-8 divide-y divide-line rounded-[22px] bg-white">
        {t.faq.items.map(([q, a]) => (
          <details class="faq group px-5 py-1">
            <summary class="flex min-h-[60px] cursor-pointer list-none items-center justify-between gap-4 text-[17px] font-semibold">{q}<span class="grid size-8 shrink-0 place-items-center rounded-full bg-mist text-[18px] transition-transform group-open:rotate-45">+</span></summary>
            <p class="pb-5 text-stone">{a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <Footer lang={lang} />

  <!-- Phone bottom bar: the two things visitors want, in thumb reach -->
  <div class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-2 gap-2 border-t border-line bg-snow/95 px-3 pb-[calc(10px+env(safe-area-inset-bottom))] pt-2.5 backdrop-blur md:hidden" data-bottombar>
    <a href="#tours" class="kbtn kbtn-gold press !min-h-12">{t.hero.cta}</a>
    <a href={wa} target="_blank" rel="noopener" class="kbtn kbtn-night press !min-h-12">WhatsApp</a>
  </div>
</Base>

<style is:global>
  .faq summary::-webkit-details-marker { display: none; }
  /* In the components layer so Tailwind's hidden/md:flex utilities still win */
  @layer components {
    .finder-f { display: flex; flex-direction: column; justify-content: center; min-height: 58px; padding: 6px 16px; border-radius: 16px; background: var(--color-mist); }
    .finder-f > span { font-size: 11px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--color-stone); }
    .finder-f select { appearance: none; background: transparent; border: 0; font: inherit; font-size: 16px; font-weight: 700; color: var(--color-night); padding: 2px 0 0; width: 100%; text-overflow: ellipsis; text-transform: capitalize; cursor: pointer; }
    .finder-f select:focus { outline: none; }
    .finder-f .dd-btn { display: flex; width: 100%; min-height: 44px; margin-top: -12px; padding: 14px 0 0; font-size: 16px; font-weight: 700; color: var(--color-night); text-transform: capitalize; text-align: start; }
    .finder-f .dd-btn:focus-visible { outline: none; }
    .finder-f:focus-within { box-shadow: inset 0 0 0 2px var(--color-sky); }
    @media (min-width: 768px) {
      .finder-f { background: transparent; border-radius: 0; }
      .finder-f + .finder-f { border-inline-start: 1px solid var(--color-line); }
      .finder .kbtn { min-height: 58px; border-radius: 16px; }
    }
    html[dir="rtl"] .finder-f > span, html[lang="hi"] .finder-f > span, html[lang="zh"] .finder-f > span { letter-spacing: 0; font-size: 12px; }
  }
  [data-bottombar] { transform: translateY(110%); transition: transform .5s var(--ease); }
  [data-bottombar].on { transform: none; }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches || new URLSearchParams(location.search).has('qa');

  const cards = [...document.querySelectorAll<HTMLElement>('.tour-card')];
  document.querySelectorAll<HTMLElement>('[data-filter]').forEach((b) => b.addEventListener('click', () => {
    const k = b.dataset.filter!;
    document.querySelectorAll('[data-filter]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    const shown = cards.filter((c) => k === 'all' || (k === 'day' && c.dataset.days === '1') || (k === 'multi' && Number(c.dataset.days) > 1) || (k === 'easy' && c.dataset.level === '1'));
    cards.forEach((c) => (c.hidden = !shown.includes(c)));
    if (!reduced) gsap.fromTo(shown, { opacity: 0, y: 20 }, { opacity: 1, y: 0, duration: 0.5, ease: 'power3.out', stagger: 0.05 });
    ScrollTrigger.refresh();
  }));

  // Trip finder: a chosen tour opens its booking with the month and guests filled in, otherwise show all tours
  document.querySelector<HTMLFormElement>('[data-finder]')!.addEventListener('submit', (e) => {
    e.preventDefault();
    const f = new FormData(e.currentTarget as HTMLFormElement);
    const slug = f.get('tour');
    if (!slug) return document.getElementById('tours')!.scrollIntoView({ behavior: 'smooth' });
    const base = location.pathname.replace(/\/$/, '');
    location.href = `${base}/tours/${slug}/?book=1&month=${f.get('month')}&guests=${f.get('guests')}`;
  });

  // Bottom bar appears after the hero
  const bar = document.querySelector<HTMLElement>('[data-bottombar]')!;
  const onScroll = () => bar.classList.toggle('on', window.scrollY > window.innerHeight * 0.6);
  onScroll(); window.addEventListener('scroll', onScroll, { passive: true });
</script>
