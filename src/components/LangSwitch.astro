---
import { langs, langMeta, path, type Lang } from '../i18n/langs';
interface Props { lang: Lang; page?: string; label: string; class?: string }
const { lang, page = '/', label, class: cls = '' } = Astro.props;
---
<details class:list={['lang-switch relative', cls]}>
  <summary class="flex h-10 cursor-pointer list-none items-center gap-2 rounded-full bg-white px-4 text-[13px] font-bold text-night ring-1 ring-line" aria-label={label}>
    <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.5 3.8 5.5 3.8 9s-1.3 6.5-3.8 9c-2.5-2.5-3.8-5.5-3.8-9S9.5 5.5 12 3z"/></svg>
    {langMeta[lang].label}
  </summary>
  <ul class="absolute end-0 top-12 z-50 min-w-[170px] overflow-hidden rounded-2xl bg-white p-1.5 text-night shadow-[0_20px_50px_-20px_rgba(12,34,51,.35)] ring-1 ring-line">
    {langs.map((l) => (
      <li>
        <a href={path(l, page)} hreflang={l} lang={l} class:list={['flex items-center justify-between gap-6 rounded-xl px-3.5 py-2.5 text-[15px] hover:bg-mist', l === lang && 'text-sky']} aria-current={l === lang ? 'true' : undefined}>
          <span>{langMeta[l].name}</span><span class="text-[12px] text-stone">{langMeta[l].label}</span>
        </a>
      </li>
    ))}
  </ul>
</details>
<style>
  .lang-switch summary::-webkit-details-marker { display: none; }
</style>
