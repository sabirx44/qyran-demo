---
// Tour photos. Phones: a swipeable strip with a counter. Desktop: one big photo and four small ones.
// "Show all photos" opens a full-screen gallery that swipes on phones and uses arrows or keys on desktop.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { mt } from '../i18n/media';
import type { Lang } from '../i18n/langs';
interface Props { pics: ImageMetadata[]; alt: string; lang: Lang }
const { pics, alt, lang } = Astro.props;
const m = mt[lang];
const grid = ['md:col-span-2 md:row-span-2', '', '', '', ''];
---
<section class="gallery relative" data-gallery>
  <div class="-mx-4 flex snap-x snap-mandatory gap-2 overflow-x-auto px-4 md:mx-0 md:grid md:h-[520px] md:grid-cols-4 md:grid-rows-2 md:gap-3 md:overflow-visible md:px-0" style="scrollbar-width:none" data-gallery-strip>
    {pics.slice(0, 5).map((p, i) => (
      <button type="button" class:list={['relative aspect-[4/5] w-[82%] shrink-0 snap-center overflow-hidden rounded-[22px] md:aspect-auto md:w-auto', grid[i]]} data-open={i} data-cursor={m.allPhotos}>
        <Image src={p} alt={`${alt} ${i + 1}`} widths={[480, 800, 1200]} sizes={i === 0 ? '(min-width: 768px) 50vw, 82vw' : '(min-width: 768px) 25vw, 82vw'} format="webp" loading={i === 0 ? 'eager' : 'lazy'} class="absolute inset-0 h-full w-full object-cover transition-transform duration-[1.2s] ease-[var(--ease)] hover:scale-[1.04]" />
      </button>
    ))}
  </div>
  <button type="button" class="absolute bottom-3 end-3 flex min-h-11 items-center gap-2 rounded-full bg-white/95 px-4 text-[14px] font-bold text-night shadow-lg backdrop-blur md:bottom-4 md:end-4" data-open="0">
    <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5" /><rect x="14" y="3" width="7" height="7" rx="1.5" /><rect x="3" y="14" width="7" height="7" rx="1.5" /><rect x="14" y="14" width="7" height="7" rx="1.5" /></svg>
    {m.allPhotos} <span class="num text-stone">{pics.length}</span>
  </button>
</section>

<dialog class="lightbox" data-lightbox aria-label={alt}>
  <div class="flex h-full flex-col">
    <div class="flex items-center justify-between px-4 pt-[calc(10px+env(safe-area-inset-top))] text-white">
      <b class="num text-[15px]" data-lb-count></b>
      <button type="button" class="grid size-11 place-items-center rounded-full bg-white/10 text-[26px]" data-lb-close aria-label={m.close}>×</button>
    </div>
    <div class="relative min-h-0 flex-1">
      <div class="flex h-full snap-x snap-mandatory overflow-x-auto" style="scrollbar-width:none" data-lb-track>
        {pics.map((p, i) => (
          <figure class="grid h-full w-full shrink-0 snap-center place-items-center p-2 md:p-10">
            <Image src={p} alt={`${alt} ${i + 1}`} widths={[800, 1400, 2000]} sizes="100vw" format="webp" loading="lazy" class="max-h-full w-auto max-w-full rounded-[14px] object-contain" />
          </figure>
        ))}
      </div>
      <button type="button" class="absolute start-4 top-1/2 hidden size-12 -translate-y-1/2 place-items-center rounded-full bg-white/90 text-night md:grid" data-lb-step="-1" aria-label={m.prev}><svg viewBox="0 0 24 24" class="size-5 rtl:-scale-x-100" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M15 6l-6 6 6 6" /></svg></button>
      <button type="button" class="absolute end-4 top-1/2 hidden size-12 -translate-y-1/2 place-items-center rounded-full bg-white/90 text-night md:grid" data-lb-step="1" aria-label={m.next}><svg viewBox="0 0 24 24" class="size-5 rtl:-scale-x-100" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg></button>
    </div>
  </div>
</dialog>

<style is:global>
  .lightbox { width: 100%; height: 100%; max-width: 100%; max-height: 100%; margin: 0; padding: 0 0 env(safe-area-inset-bottom); border: 0; background: rgba(6, 16, 24, .97); }
  .lightbox::backdrop { background: transparent; }
  .lightbox[open] { animation: lb-in .35s var(--ease); }
  @keyframes lb-in { from { opacity: 0; } }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((g) => {
    const lb = g.nextElementSibling as HTMLDialogElement;
    const track = lb.querySelector<HTMLElement>('[data-lb-track]')!;
    const count = lb.querySelector<HTMLElement>('[data-lb-count]')!;
    const n = track.children.length;
    const rtl = document.documentElement.dir === 'rtl';
    const idx = () => Math.round(Math.abs(track.scrollLeft) / track.clientWidth);
    const show = () => (count.textContent = `${idx() + 1} / ${n}`);
    const go = (i: number) => track.scrollTo({ left: (rtl ? -1 : 1) * Math.max(0, Math.min(n - 1, i)) * track.clientWidth, behavior: 'smooth' });
    g.querySelectorAll<HTMLElement>('[data-open]').forEach((b) => b.addEventListener('click', () => {
      lb.showModal();
      track.scrollTo({ left: (rtl ? -1 : 1) * Number(b.dataset.open) * track.clientWidth });
      show();
    }));
    track.addEventListener('scroll', show, { passive: true });
    lb.querySelectorAll<HTMLElement>('[data-lb-step]').forEach((b) => b.addEventListener('click', () => go(idx() + Number(b.dataset.lbStep))));
    lb.querySelector('[data-lb-close]')!.addEventListener('click', () => lb.close());
    lb.addEventListener('keydown', (e) => { if (e.key === 'ArrowRight') go(idx() + (rtl ? -1 : 1)); if (e.key === 'ArrowLeft') go(idx() + (rtl ? 1 : -1)); });
  });
</script>
