---
// QYRAN mark, drawn in thin line like an engraved seal: the sun of the Kazakh flag as a ring,
// and a golden eagle ("qyran") gliding across it, wings in one continuous stroke.
// Strokes use pathLength=1 so the intro can draw them. Wing colour follows the text colour.
interface Props { class?: string; draw?: boolean }
const { class: cls = '', draw = false } = Astro.props;
---
<svg viewBox="0 0 64 64" class:list={['block', cls, draw && 'qy-draw']} aria-hidden="true" fill="none" stroke-linecap="round" stroke-linejoin="round">
  <circle cx="32" cy="29" r="15.5" stroke="var(--color-gold)" stroke-width="2" pathLength="1" />
  <path d="M3.5 35.5 C 12 29.5, 22.5 28.5, 32 38.5 C 41.5 28.5, 52 29.5, 60.5 35.5" stroke="currentColor" stroke-width="2.6" pathLength="1" />
  <path d="M9.5 33.2 l-2.2 -3.4 M15 31.4 l-1.6 -3.6 M54.5 33.2 l2.2 -3.4 M49 31.4 l1.6 -3.6" stroke="currentColor" stroke-width="1.8" pathLength="1" />
</svg>
