---
// QYRAN mark: the flag's sun with a golden eagle's wings crossing it
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<svg viewBox="0 0 64 64" class:list={['block', cls]} aria-hidden="true">
  <g transform="translate(32 30)" fill="#F2B233">
    {Array.from({ length: 16 }, (_, i) => <path d="M-2.2 -17 L0 -27 L2.2 -17Z" transform={`rotate(${i * 22.5})`} />)}
    <circle r="14" />
  </g>
  <path d="M32 36 C 26 30 14 27 3 30 C 11 32 17 35 21 39 C 15 40 11 43 8 47 C 16 44 22 44 27 45 L32 52 L37 45 C 42 44 48 44 56 47 C 53 43 49 40 43 39 C 47 35 53 32 61 30 C 50 27 38 30 32 36 Z" fill="#0C2233" stroke="#F7F8F5" stroke-width="1.5" stroke-linejoin="round" />
</svg>
