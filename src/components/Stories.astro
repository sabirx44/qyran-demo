---
// Instagram-style stories: a circle per tour, tapping opens full-screen vertical clips and photos
// with progress bars, tap zones and a Book button. Visitors arrive from Instagram and WhatsApp and already know this pattern.
import { getImage } from 'astro:assets';
import { tours } from '../data/tours';
import { photos, clips } from '../data/media';
import { ui } from '../i18n/ui';
import { mt } from '../i18n/media';
import { path, type Lang } from '../i18n/langs';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const m = mt[lang];

const data = await Promise.all(tours.map(async (tour) => {
  const pics = photos(tour.slug);
  const ring = await getImage({ src: pics[0], width: 160, height: 160, fit: 'cover', format: 'webp' });
  const slides = await Promise.all(pics.slice(1, 4).map(async (p) => ({ img: (await getImage({ src: p, width: 1080, format: 'webp', quality: 70 })).src })));
  return {
    slug: tour.slug, name: tour.name[lang], usd: tour.group, ring: ring.src, href: path(lang, `/tours/${tour.slug}/?book=1`),
    slides: [{ video: `/media/${tour.slug}-m.mp4`, poster: `/media/${tour.slug}-m.webp` }, ...slides],
  };
}));
---
<div class="reels" role="list" aria-label={m.stories}>
  {data.map((s, i) => (
    <button type="button" class="reel press group" data-story={i} role="listitem" data-cursor={m.watch} aria-label={`${m.watch}: ${s.name}`}>
      <span class="reel-media">
        <img src={s.slides[0].poster} alt="" width="720" height="1280" loading="lazy" decoding="async" />
        <video muted playsinline loop preload="none" data-src={s.slides[0].video} aria-hidden="true"></video>
      </span>
      <span class="reel-bars" aria-hidden="true">{s.slides.map(() => <i></i>)}</span>
      <span class="reel-play" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13l11-6.5z" /></svg></span>
      <span class="reel-text">
        <b class="display block text-[17px] leading-[1.1] md:text-[19px]">{s.name}</b>
        <span class="mt-1.5 block text-[12px] text-white/80">{t.card.from} <b class="num text-[14px] text-white" dir="ltr" data-usd={s.usd}>${s.usd}</b></span>
      </span>
    </button>
  ))}
</div>

<dialog class="story" data-story-dialog aria-label={m.stories}>
  <div class="story-frame">
    <div class="story-media" data-story-media></div>
    <div class="absolute inset-x-0 top-0 z-10 bg-gradient-to-b from-black/60 to-transparent px-3 pb-10 pt-[calc(10px+env(safe-area-inset-top))]">
      <div class="flex gap-1" data-story-bars></div>
      <div class="mt-3 flex items-center gap-2.5 text-white">
        <img class="size-9 rounded-full object-cover ring-2 ring-white/70" alt="" data-story-avatar />
        <p class="min-w-0 flex-1 leading-tight"><b class="block truncate text-[14px]" data-story-name></b><span class="text-[12px] text-white/75">{m.sound}</span></p>
        <button type="button" class="grid size-11 place-items-center rounded-full text-[26px]" data-story-close aria-label={m.close}>×</button>
      </div>
    </div>
    <button type="button" class="absolute inset-y-0 start-0 z-[5] w-1/3" data-story-prev aria-label={m.prev}></button>
    <button type="button" class="absolute inset-y-0 end-0 z-[5] w-2/3" data-story-next aria-label={m.next}></button>
    <div class="absolute inset-x-0 bottom-0 z-10 flex items-end gap-3 bg-gradient-to-t from-black/70 to-transparent px-4 pb-[calc(16px+env(safe-area-inset-bottom))] pt-16 text-white">
      <p class="me-auto leading-tight"><span class="block text-[12px] text-white/75">{t.card.from}</span><b class="num text-[24px]" dir="ltr" data-story-price></b><span class="text-[12px] text-white/75"> / {t.card.person}</span></p>
      <a class="kbtn kbtn-gold press !min-h-12 !px-7" data-story-book>{t.card.book}</a>
    </div>
  </div>
</dialog>
<script type="application/json" id="story-data" set:html={JSON.stringify(data)} />

<style is:global>
  /* Story reels: tall 9:16 cards, a swipeable row on phones, one full-width row on desktop */
  .reels { display: flex; gap: 10px; margin-inline: -16px; padding: 4px 16px 8px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; }
  .reels::-webkit-scrollbar { display: none; }
  @media (min-width: 900px) { .reels { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 16px; margin: 0; padding: 4px 0 8px; overflow: visible; } }
  .reel { position: relative; flex: 0 0 min(42vw, 190px); aspect-ratio: 9 / 16; scroll-snap-align: start; border-radius: 20px; text-align: start; color: #fff;
    background: conic-gradient(from 210deg, var(--color-gold), var(--color-sky-2), var(--color-gold-2), var(--color-sky), var(--color-gold)); box-shadow: 0 24px 40px -28px rgba(11,28,38,.7); }
  @media (min-width: 900px) { .reel { flex: none; width: auto; } }
  .reel-media { position: absolute; inset: 2.5px; overflow: hidden; border-radius: 17.5px; background: var(--color-night); }
  .reel-media > * { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--ease), opacity .4s; }
  .reel-media video { opacity: 0; }
  .reel.playing .reel-media video { opacity: 1; }
  .reel:hover .reel-media > * { transform: scale(1.06); }
  .reel-media::after { content: ""; position: absolute; inset: 0; background: linear-gradient(to top, rgba(11,28,38,.9) 0%, rgba(11,28,38,.25) 45%, transparent 60%, rgba(11,28,38,.45) 100%); }
  .reel-bars { position: absolute; z-index: 1; inset-inline: 12px; top: 12px; display: flex; gap: 4px; }
  .reel-bars i { flex: 1; height: 2.5px; border-radius: 2px; background: rgba(255,255,255,.45); }
  .reel-bars i:first-child { background: #fff; }
  .reel-play { position: absolute; z-index: 1; top: 50%; left: 50%; display: grid; place-items: center; width: 50px; height: 50px; margin: -25px 0 0 -25px; border-radius: 999px; color: #fff; background: rgba(255,255,255,.2); backdrop-filter: blur(10px); box-shadow: inset 0 0 0 1px rgba(255,255,255,.45); transition: transform .4s var(--ease), opacity .3s; }
  .reel-play svg { width: 20px; height: 20px; margin-inline-start: 3px; }
  .reel-play::after { content: ""; position: absolute; inset: -6px; border-radius: inherit; border: 1.5px solid rgba(255,255,255,.55); animation: reel-pulse 2.4s var(--ease) infinite; }
  .reel:hover .reel-play { transform: scale(1.1); }
  .reel.playing .reel-play { opacity: 0; }
  @keyframes reel-pulse { 0% { transform: scale(.85); opacity: 1; } 80%, 100% { transform: scale(1.35); opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .reel-play::after { animation: none; } }
  .reel-text { position: absolute; z-index: 1; inset-inline: 12px; bottom: 12px; }

  .story { width: 100%; height: 100%; max-width: 100%; max-height: 100%; margin: 0; padding: 0; border: 0; background: #000; }
  .story::backdrop { background: rgba(4, 12, 18, .92); }
  .story-frame { position: relative; height: 100dvh; width: 100%; margin: auto; overflow: hidden; background: #000; user-select: none; -webkit-user-select: none; }
  @media (min-width: 700px) { .story { background: transparent; } .story-frame { width: min(440px, calc(100dvh * 9 / 16)); height: min(96dvh, 860px); margin-top: 2dvh; border-radius: 22px; } }
  .story-media > * { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .story[open] .story-frame { animation: story-in .45s var(--ease); }
  @keyframes story-in { from { transform: scale(.92); opacity: 0; } }
  .story-bar { flex: 1; height: 3px; border-radius: 3px; background: rgba(255,255,255,.35); overflow: hidden; }
  .story-bar i { display: block; height: 100%; width: 0; background: #fff; }
  html[dir="rtl"] .story-bar i { margin-inline-start: auto; }
</style>

<script>
  type Slide = { video?: string; poster?: string; img?: string };
  type Story = { name: string; usd: number; ring: string; href: string; slides: Slide[] };
  const S: Story[] = JSON.parse(document.getElementById('story-data')!.textContent!);
  const dlg = document.querySelector<HTMLDialogElement>('[data-story-dialog]')!;
  const media = dlg.querySelector<HTMLElement>('[data-story-media]')!;
  const bars = dlg.querySelector<HTMLElement>('[data-story-bars]')!;
  const IMG_MS = 5000;
  let si = 0, sl = 0, raf = 0, start = 0, paused = false, elapsedAtPause = 0, skipClick = false;

  function open(i: number) { si = i; sl = 0; if (!dlg.open) dlg.showModal(); render(); }
  function close() { cancelAnimationFrame(raf); media.innerHTML = ''; dlg.close(); }
  function render() {
    cancelAnimationFrame(raf);
    const s = S[si];
    dlg.querySelector<HTMLImageElement>('[data-story-avatar]')!.src = s.ring;
    dlg.querySelector('[data-story-name]')!.textContent = s.name;
    const price = dlg.querySelector<HTMLElement>('[data-story-price]')!;
    price.textContent = (window as any).qyMoney?.fmt(s.usd) ?? `$${s.usd}`;
    dlg.querySelector<HTMLAnchorElement>('[data-story-book]')!.href = s.href;
    bars.innerHTML = s.slides.map((_, k) => `<span class="story-bar"><i style="width:${k < sl ? 100 : 0}%"></i></span>`).join('');
    const slide = s.slides[sl];
    media.innerHTML = '';
    if (slide.video) {
      const v = document.createElement('video');
      Object.assign(v, { src: slide.video, poster: slide.poster, muted: true, playsInline: true, autoplay: true });
      v.setAttribute('playsinline', '');
      v.onended = next;
      media.appendChild(v);
      v.play().catch(() => {});
      tick(() => (v.duration ? v.currentTime / v.duration : 0));
    } else {
      const img = new Image(); img.src = slide.img!; img.alt = ''; media.appendChild(img);
      start = performance.now(); elapsedAtPause = 0;
      tick(() => (performance.now() - start) / IMG_MS, true);
    }
    // Warm up the next slide
    const nx = s.slides[sl + 1] || S[si + 1]?.slides[0];
    if (nx?.img) new Image().src = nx.img;
  }
  function tick(progress: () => number, timed = false) {
    const bar = bars.children[sl]?.querySelector('i') as HTMLElement;
    const step = () => {
      if (!paused) {
        const p = Math.min(1, progress());
        bar.style.width = `${p * 100}%`;
        if (timed && p >= 1) return next();
      }
      raf = requestAnimationFrame(step);
    };
    raf = requestAnimationFrame(step);
  }
  function next() { if (sl < S[si].slides.length - 1) sl++; else if (si < S.length - 1) { si++; sl = 0; } else return close(); render(); }
  function prev() { if (sl > 0) sl--; else if (si > 0) { si--; sl = 0; } render(); }

  document.querySelectorAll<HTMLElement>('[data-story]').forEach((b) => b.addEventListener('click', () => open(Number(b.dataset.story))));
  // Desktop: the reel starts playing under the pointer. Phones keep the poster to save data.
  if (matchMedia('(hover: hover) and (pointer: fine)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<HTMLElement>('.reel').forEach((r) => {
      const v = r.querySelector('video')!;
      r.addEventListener('pointerenter', () => { if (!v.src) v.src = v.dataset.src!; v.play().then(() => r.classList.add('playing')).catch(() => {}); });
      r.addEventListener('pointerleave', () => { v.pause(); r.classList.remove('playing'); });
    });
  }
  const rtl = document.documentElement.dir === 'rtl';
  // Tap zones sit at the logical start and end, so they already follow RTL
  const tap = (fwd: boolean) => () => { if (skipClick) { skipClick = false; return; } (fwd ? next : prev)(); };
  dlg.querySelector('[data-story-next]')!.addEventListener('click', tap(true));
  dlg.querySelector('[data-story-prev]')!.addEventListener('click', tap(false));
  dlg.querySelector('[data-story-close]')!.addEventListener('click', close);
  dlg.addEventListener('click', (e) => { if (e.target === dlg) close(); });
  dlg.addEventListener('close', () => { cancelAnimationFrame(raf); media.innerHTML = ''; });
  dlg.addEventListener('keydown', (e) => { if (e.key === 'ArrowRight') next(); if (e.key === 'ArrowLeft') prev(); });

  // Hold to pause, swipe down to close, swipe sideways to jump between tours
  let x0 = 0, y0 = 0, t0 = 0;
  const frame = dlg.querySelector<HTMLElement>('.story-frame')!;
  frame.addEventListener('pointerdown', (e) => {
    x0 = e.clientX; y0 = e.clientY; t0 = performance.now();
    paused = true; elapsedAtPause = performance.now() - start;
    media.querySelector('video')?.pause();
  });
  frame.addEventListener('pointerup', (e) => {
    const dx = e.clientX - x0, dy = e.clientY - y0;
    start = performance.now() - elapsedAtPause; paused = false;
    media.querySelector('video')?.play().catch(() => {});
    if (dy > 90 && Math.abs(dy) > Math.abs(dx)) { close(); return; }
    skipClick = performance.now() - t0 > 350; // a long press only pauses
    if (Math.abs(dx) > 70) { skipClick = true; const fwd = (dx < 0) !== rtl; if (fwd && si < S.length - 1) { si++; sl = 0; render(); } else if (!fwd && si > 0) { si--; sl = 0; render(); } }
  });
  document.addEventListener('qy-currency', () => { if (dlg.open) dlg.querySelector('[data-story-price]')!.textContent = (window as any).qyMoney.fmt(S[si].usd); });
</script>
